    "forensics": "interpretation_topology",
    "repair": "correction_topology",
    "optimize": "simplification_topology",
    "adversarial": "falsification_topology",
    "validation": "verdict_topology",
    "artifact": "runtime_promoted_fact",
    "epistemic_handover": "runtime_promoted_incomplete_observation",
    "capability_payload": "runtime_owned_evidence",
    "git": "persistence"
