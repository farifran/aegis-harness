{
  "version": "2.0",
  "architecture": {
    "governance": {
      "authority_root": "AGENTS.md",
      "runtime_authority": "runtime_aegis.sh",
      "continuity_authority": ".harness/runtime",
      "structural_truth_source": "repository topology"
    },
    "runtime": {
      "execution_model": "disposable_worktree_execution",
      "execution_isolation": "ephemeral_git_worktrees",
      "containment_model": "runtime_governed_persistence",
      "continuity_model": "explicit_runtime_promotion",
      "runtime_characteristics": [
        "mechanically_deterministic",
        "semantically_blind",
        "persistence_authoritative",
        "sandbox_oriented"
      ]
    },
    "executor_topology": {
      "analysis_modes": {
        "modes": [
          "discovery",
          "forensics",
          "validation",
          "adversarial"
        ],
        "topology": "analysis_only_cognition",
        "authority": [
          "observation",
          "assessment",
          "inspection",
          "bounded_analysis"
        ],
        "persistence_authority": false
      },
      "mutation_modes": {
        "modes": [
          "repair",
          "optimize"
        ],
        "topology": "mutation_authorized_cognition",
        "authority": [
          "bounded_mutation",
          "authorized_modification",
          "implementation_adjustment"
        ],
        "persistence_authority": false
      }
    },
    "sandbox_model": {
      "sandbox_type": "isolated_git_worktree",
      "sandbox_characteristics": [
        "ephemeral",
        "disposable",
        "non_authoritative",
        "filesystem_isolated"
      ],
      "sandbox_allowed_behaviors": [
        "patch_generation",
        "artifact_materialization",
        "coding_oriented_cognition",
        "temporary_filesystem_mutation",
        "transient_operational_state"
      ],
      "sandbox_persistence": "runtime_promoted_only"
    },
    "promotion_pipeline": {
      "promotion_authority": "runtime_only",
      "promotion_targets": [
        "active_task.md",
        "validated_runtime_outputs",
        "authorized_repository_mutations"
      ],
      "promotion_constraints": [
        "explicit",
        "observable",
        "runtime_validated",
        "mechanically_bounded"
      ]
    },
    "continuity": {
      "persistent_state": [
        ".harness/runtime/active_task.md",
        ".harness/runtime/last_good_active_task.md"
      ],
      "transient_state": [
        ".harness/worktrees"
      ],
      "continuity_rules": [
        "sandbox_state_is_non_authoritative",
        "implicit_persistence_forbidden",
        "runtime_owns_continuity",
        "promotion_required_for_survival"
      ]
    },
    "containment": {
      "primary_containment": [
        "filesystem_isolation",
        "sandbox_disposal",
        "runtime_promotion_governance"
      ],
      "secondary_containment": [
        "prompt_alignment",
        "mode_constraints",
        "bounded_context_injection"
      ],
      "containment_principles": [
        "executor_topology_is_non_neutral",
        "prompt_alignment_is_insufficient",
        "disposable_execution_is_preferred",
        "mechanical_boundaries_are_authoritative"
      ]
    }
  }
}