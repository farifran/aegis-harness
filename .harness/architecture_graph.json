  "runtime": {
    "authority": "sovereign",
    "classification": "runtime_owned",
    "responsibilities": [
      "execution_surface_lifecycle",
      "capability_environment_lifecycle",
      "capability_payload_materialization",
      "execution_orchestration",
      "execution_routing",
      "protocol_enforcement",
      "artifact_promotion",
      "artifact_validation",
      "epistemic_handover_materialization",
      "epistemic_handover_validation",
      "epistemic_handover_update",
      "cleanup",
      "capability_routing",
      "persistence_decisions"
    ],
    "forbidden": [
      "semantic_reasoning",
      "architectural_interpretation",
      "implicit_authority_expansion",
      "hidden_continuity",
      "topology_self_redefinition"
    ]
  },
  "executor": {
    "type": "protocol_virtual_machine",
    "classification": "bounded_execution_orchestrator",
    "responsibilities": [
      "contract_loading",
      "capability_envelope_resolution",
      "capability_environment_materialization",
      "capability_payload_generation",
      "substrate_routing",
      "protocol_validation",
      "artifact_normalization",
      "payload_validation",
      "mode_identity_validation"
    ],
    "forbidden": [
      "epistemic_handover_ownership",
      "persistence_ownership",
      "semantic_inference",
      "implicit_repository_exposure",
      "runtime_authority_override"
    ]
  },
  "evidence_exposure": {
    "model": "runtime_exposed_evidence",
    "classification": "runtime_materialized_capability_payloads",
    "principles": [
      "repository_access_is_explicit",
      "runtime_exposed_evidence_is_runtime_owned",
      "capability_payloads_are_runtime_owned_evidence",
      "capability_payloads_are_not_memory",
      "repository_awareness_is_not_implicit",
      "runtime_exposed_evidence_is_observable",
      "runtime_exposed_evidence_is_mechanically_materialized"
    ],
    "forbidden": [
      "assistant_style_repository_inheritance",
      "hidden_repository_visibility",
      "prompt_only_context_inference",
      "unrestricted_context_inheritance",
      "hidden_operational_memory"
    ]
  },
  "capability_topology": {
    "model": "runtime_owned_capability_surfaces",
    "capability_root": "scripts/capabilities",
    "classification": {
      "readonly": "readonly_cognition_surface",
      "bounded_mutation": "mutation_surface"
    },
    "capability_classes": {
      "filesystem": {
        "readonly": [
          "filesystem.read",
          "filesystem.list_tree",
          "filesystem.search_symbol"
        ]
      },
      "git": {
        "readonly": [
          "git.diff",
          "git.status"
        ]
      },
      "topology": {
        "readonly": [
          "topology.read_graph"
        ]
      },
      "runtime": {
        "readonly": [
          "runtime.read_epistemic_handover"
        ]
      }
    },
    "future_extension_surfaces": [
      "filesystem.write",
      "patch.apply",
      "dependency.install",
      "topology.validate"
    ]
  },
  "mode_topology": {
    "readonly_cognition_modes": {
      "classification": "readonly_cognition",
      "modes": {
        "discovery": {
          "topology": "observation",
          "authority": "readonly",
          "execution_engine": "raw",
          "mutation_authority": false,
          "epistemic_handover_ownership": false,
          "evidence_model": "capability_payloads"
        },
        "forensics": {
          "topology": "interpretation",
          "authority": "readonly",
          "execution_engine": "raw",
          "mutation_authority": false,
          "epistemic_handover_ownership": false,
          "evidence_model": "capability_payloads"
        },
        "validation": {
          "topology": "verdict",
          "authority": "readonly",
          "execution_engine": "raw",
          "mutation_authority": false,
          "epistemic_handover_ownership": false,
          "evidence_model": "capability_payloads"
        },
        "adversarial": {
          "topology": "falsification",
          "authority": "readonly",
          "execution_engine": "raw",
          "mutation_authority": false,
          "epistemic_handover_ownership": false,
          "evidence_model": "capability_payloads"
        }
      }
    },
    "mutation_modes": {
      "classification": "bounded_mutation_cognition",
      "modes": {
        "repair": {
          "topology": "correction",
          "authority": "bounded_mutation",
          "execution_engine": "aider",
          "mutation_authority": true,
          "epistemic_handover_ownership": false,
          "evidence_model": "capability_payloads"
        },
        "optimize": {
          "topology": "simplification",
          "authority": "bounded_mutation",
          "execution_engine": "aider",
          "mutation_authority": true,
          "epistemic_handover_ownership": false,
          "evidence_model": "capability_payloads"
        }
      }
    }
  },
  "execution_substrates": {
    "raw": {
      "classification": "readonly_cognition_substrate",
      "used_by": [
        "discovery",
        "forensics",
        "validation",
        "adversarial"
      ],
      "properties": [
        "json_only_output",
        "provider_bounded",
        "deterministic_protocol",
        "readonly_cognition",
        "runtime_governed"
      ]
    },
    "aider": {
      "classification": "bounded_mutation_substrate",
      "used_by": [
        "repair",
        "optimize"
      ],
      "properties": [
        "bounded_mutation",
        "patch_oriented",
        "runtime_governed",
        "capability_scoped"
      ]
    }
  },
  "artifact_model": {
    "classification": "runtime_promoted_fact",
    "properties": [
      "runtime_validated",
      "protocol_framed",
      "execution_scoped",
      "not_operational_memory"
    ]
  },
  "operational_memory_model": {
    "classification": "three_surface_memory_boundary",
    "principles": [
      "capability_payloads_are_runtime_owned_evidence",
      "capability_payloads_are_not_memory",
      "epistemic_handover_is_incomplete_attention",
      "epistemic_handover_is_not_truth",
      "epistemic_handover_is_not_evidence",
      "epistemic_handover_is_not_interpretation",
      "git_is_persistent_memory",
      "no_intermediate_operational_memory_surface"
    ],
    "surfaces": {
      "capability_payloads": {
        "classification": "runtime_owned_evidence_surface",
        "location": ".harness/runtime/capability_payloads",
        "properties": [
          "runtime_owned",
          "execution_scoped",
          "evidence_only",
          "not_memory"
        ]
      },
      "epistemic_handover": {
        "classification": "runtime_promoted_incomplete_observation",
        "files": [
          ".harness/runtime/epistemic_handover.json",
          ".harness/runtime/last_good_epistemic_handover.json"
        ],
        "purpose": [
          "observations_incomplete",
          "areas_not_inspected",
          "evidence_insufficient",
          "limitations_observed"
        ],
        "properties": [
          "promoted_incomplete_observation",
          "guidance_only",
          "not_truth",
          "not_evidence",
          "not_interpretation",
          "not_memory"
        ],
        "consumers": [
          "forensics",
          "repair",
          "optimize",
          "adversarial",
          "validation"
        ]
      },
      "git": {
        "classification": "persistent_memory_surface",
        "location": ".git",
        "properties": [
          "persistent",
          "accepted_change_history",
          "long_term_memory"
        ]
      }
    },
    "forbidden": [
      "assistant_memory",
      "hidden_persistence",
      "implicit_state_inheritance",
      "cross_execution_memory",
      "intermediate_operational_memory_surface"
    ]
  },
  "protocol_model": {
    "execution_model": "non_conversational",
    "requirements": [
      "single_json_artifact",
      "machine_parseable_output",
      "runtime_framed_execution",
      "artifact_validation",
      "mode_identity_validation"
    ],
    "rejected": [
      "assistant_narration",
      "clarification_loops",
      "mixed_protocol_output",
      "conversational_drift",
      "implicit_execution_state"
    ]
  },
  "containment_model": {
    "execution_boundary": "disposable_execution_surface",
    "principles": [
      "capability_bound_authority",
      "runtime_owned_cleanup",
      "explicit_mutation_surfaces",
      "transient_execution_state",
      "isolated_execution_surface"
    ],
    "forbidden": [
      "cross_mode_state_inheritance",
      "hidden_mutation",
      "implicit_authority_expansion",
      "persistent_runtime_residue"
    ]
