  },
  "constitutional_invariants": [
    "runtime_remains_sovereign",
    "authority_remains_explicit",
    "grounding_remains_capability_bounded",
    "continuity_remains_ephemeral",
    "persistence_remains_explicit",
    "execution_remains_protocol_oriented",
    "capabilities_remain_bounded",
    "topology_remains_observable",
    "mutation_remains_runtime_governed",
    "epistemic_handover_remains_guidance_only"
  ]
}