  "constitutional_principles": [
    "runtime_governs_execution",
    "capabilities_bound_authority",
    "capability_exposure_is_explicit",
    "operational_memory_has_three_surfaces",
    "capability_payloads_are_evidence_not_memory",
    "artifacts_are_promoted_facts",
    "persistence_is_explicit",
    "execution_is_protocol_oriented",
    "topology_is_observable",
    "cognition_is_bounded",
    "repository_awareness_is_capability_bounded",
    "epistemic_handover_is_explicit",
    "git_is_persistent_memory"
