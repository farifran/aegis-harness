{
  "schema_version": "3.0",
  "topology_version": "2.1",
  "constitutional_layer": "layer_1",
  "constitutional_status": "active",
  "compatibility_class": "runtime_capability_topology",
  "change_policy": "frozen_by_default",
  "system": {
    "name": "Aegis Harness",
    "architecture_type": "bounded_capability_runtime",
    "execution_model": "protocol_oriented",
    "grounding_model": "runtime_exposed_capabilities",
    "continuity_model": "ephemeral_runtime_state",
    "persistence_model": "explicit_git_persistence",
    "authority_model": "runtime_sovereignty"
  },
  "constitutional_principles": [
    "runtime_governs_execution",
    "capabilities_bound_authority",
    "grounding_is_explicit",
    "continuity_is_ephemeral",
    "persistence_is_explicit",
    "execution_is_protocol_oriented",
    "topology_is_observable",
    "cognition_is_bounded",
    "repository_awareness_is_capability_bounded",
    "epistemic_handover_is_explicit"
  ],
  "runtime": {
    "authority": "sovereign",
    "classification": "runtime_owned",
    "responsibilities": [
      "worktree_lifecycle",
      "capability_environment_lifecycle",
      "capability_payload_materialization",
      "execution_orchestration",
      "execution_routing",
      "protocol_enforcement",
      "artifact_validation",
      "epistemic_handover_materialization",
      "epistemic_handover_promotion",
      "continuity_promotion",
      "cleanup",
      "capability_routing",
      "persistence_decisions"
    ],
    "forbidden": [
      "semantic_reasoning",
      "architectural_interpretation",
      "implicit_authority_expansion",
      "hidden_continuity",
      "topology_self_redefinition"
    ]
  },
  "executor": {
    "type": "protocol_virtual_machine",
    "classification": "bounded_execution_orchestrator",
    "responsibilities": [
      "contract_loading",
      "capability_envelope_resolution",
      "capability_environment_materialization",
      "capability_payload_generation",
      "substrate_routing",
      "protocol_validation",
      "artifact_normalization",
      "payload_validation",
      "mode_identity_validation"
    ],
    "forbidden": [
      "continuity_ownership",
      "persistence_ownership",
      "semantic_inference",
      "implicit_repository_grounding",
      "runtime_authority_override"
    ]
  },
  "grounding": {
    "model": "capability_grounded_execution",
    "classification": "runtime_materialized_operational_evidence",
    "principles": [
      "repository_access_is_explicit",
      "grounding_is_runtime_exposed",
      "capability_payloads_are_authoritative",
      "repository_awareness_is_not_implicit",
      "grounding_is_observable",
      "grounding_is_mechanically_materialized",
      "epistemic_handover_is_incomplete_attention"
    ],
    "forbidden": [
      "assistant_style_repository_inheritance",
      "hidden_repository_visibility",
      "prompt_only_grounding",
      "unrestricted_context_inheritance",
      "hidden_operational_memory"
    ]
  },
  "capability_topology": {
    "model": "runtime_owned_capability_surfaces",
    "capability_root": "scripts/capabilities",
    "classification": {
      "readonly": "analysis_surface",
      "bounded_mutation": "mutation_surface"
    },
    "capability_classes": {
      "filesystem": {
        "readonly": [
          "filesystem.read",
          "filesystem.list_tree",
          "filesystem.search_symbol"
        ]
      },
      "git": {
        "readonly": [
          "git.diff",
          "git.status"
        ]
      },
      "topology": {
        "readonly": [
          "topology.read_graph"
        ]
      },
      "runtime": {
        "readonly": [
          "runtime.read_epistemic_handover"
        ]
      }
    },
    "future_extension_surfaces": [
      "filesystem.write",
      "patch.apply",
      "dependency.install",
      "topology.validate",
      "artifact.promote"
    ]
  },
  "mode_topology": {
    "analysis_modes": {
      "classification": "readonly_cognition",
      "modes": {
        "discovery": {
          "authority": "readonly",
          "execution_engine": "raw",
          "mutation_authority": false,
          "continuity_ownership": false,
          "grounding_model": "capability_payloads"
        },
        "forensics": {
          "authority": "readonly",
          "execution_engine": "raw",
          "mutation_authority": false,
          "continuity_ownership": false,
          "grounding_model": "capability_payloads"
        },
        "validation": {
          "authority": "readonly",
          "execution_engine": "raw",
          "mutation_authority": false,
          "continuity_ownership": false,
          "grounding_model": "capability_payloads"
        },
        "adversarial": {
          "authority": "readonly",
          "execution_engine": "raw",
          "mutation_authority": false,
          "continuity_ownership": false,
          "grounding_model": "capability_payloads"
        }
      }
    },
    "mutation_modes": {
      "classification": "bounded_mutation_cognition",
      "modes": {
        "repair": {
          "authority": "bounded_mutation",
          "execution_engine": "aider",
          "mutation_authority": true,
          "continuity_ownership": false,
          "grounding_model": "capability_payloads"
        },
        "optimize": {
          "authority": "bounded_mutation",
          "execution_engine": "aider",
          "mutation_authority": true,
          "continuity_ownership": false,
          "grounding_model": "capability_payloads"
        }
      }
    }
  },
  "execution_substrates": {
    "raw": {
      "classification": "bounded_readonly_cognition",
      "used_by": [
        "discovery",
        "forensics",
        "validation",
        "adversarial"
      ],
      "properties": [
        "json_only_output",
        "provider_bounded",
        "deterministic_protocol",
        "readonly_cognition",
        "runtime_grounded"
      ]
    },
    "aider": {
      "classification": "bounded_mutation_substrate",
      "used_by": [
        "repair",
        "optimize"
      ],
      "properties": [
        "bounded_mutation",
        "patch_oriented",
        "runtime_governed",
        "capability_scoped"
      ]
    }
  },
  "continuity_model": {
    "classification": "runtime_owned_ephemeral_state",
    "runtime_state_files": [
      ".harness/runtime/epistemic_handover.json",
      ".harness/runtime/last_good_epistemic_handover.json"
    ],
    "principles": [
      "continuity_is_explicit",
      "continuity_is_runtime_owned",
      "continuity_is_disposable",
      "git_is_durable_persistence"
    ],
    "forbidden": [
      "assistant_memory",
      "hidden_persistence",
      "implicit_state_inheritance",
      "cross_execution_memory"
    ]
  },
  "epistemic_handover_model": {
    "classification": "runtime_owned_epistemic_attention",
    "handover_file": ".harness/runtime/epistemic_handover.json",
    "last_good_handover_file": ".harness/runtime/last_good_epistemic_handover.json",
    "purpose": [
      "observations_incomplete",
      "areas_not_inspected",
      "evidence_insufficient",
      "limitations_observed"
    ],
    "principles": [
      "handover_is_explicit",
      "handover_is_runtime_owned",
      "handover_is_ephemeral",
      "handover_is_guidance_not_truth",
      "handover_is_not_memory"
    ],
    "allowed_content": [
      "incomplete_observations",
      "uninspected_areas",
      "insufficient_evidence",
      "observed_limitations"
    ],
    "forbidden_content": [
      "hypotheses",
      "conclusions",
      "causal_claims",
      "recommendations",
      "interpretations",
      "redesign",
      "severity_judgments",
      "hidden_reasoning_chains"
    ],
    "consumers": [
      "forensics",
      "repair",
      "optimize",
      "adversarial",
      "validation"
    ]
  },
  "protocol_model": {
    "execution_model": "non_conversational",
    "requirements": [
      "single_json_artifact",
      "machine_parseable_output",
      "runtime_framed_execution",
      "artifact_validation",
      "mode_identity_validation"
    ],
    "rejected": [
      "assistant_narration",
      "clarification_loops",
      "mixed_protocol_output",
      "conversational_drift",
      "implicit_execution_state"
    ]
  },
  "containment_model": {
    "execution_boundary": "disposable_worktree",
    "principles": [
      "capability_bound_authority",
      "runtime_owned_cleanup",
      "explicit_mutation_surfaces",
      "transient_execution_state",
      "isolated_execution_surface"
    ],
    "forbidden": [
      "cross_mode_state_inheritance",
      "hidden_mutation",
      "implicit_authority_expansion",
      "persistent_runtime_residue"
    ]
  },
  "surface_classification": {
    "authoritative": [
      "AGENTS.md",
      ".harness/architecture_graph.json",
      ".harness/config.sh"
    ],
    "derived": [
      "README.md",
      "summary.md",
      "operator_docs",
      "onboarding_material"
    ],
    "transient": [
      ".harness/runtime/epistemic_handover.json",
      ".harness/runtime/last_good_epistemic_handover.json",
      ".harness/runtime/capability_env",
      ".harness/runtime/capability_payloads",
      ".harness/worktrees"
    ]
  },
  "governance": {
    "precedence_order": [
      "AGENTS.md",
      ".harness/architecture_graph.json",
      ".harness/config.sh",
      ".skills/*.md",
      "runtime_scripts",
      "README.md",
      "summary.md"
    ],
    "change_governance": {
      "default_state": "frozen",
      "reopen_conditions": [
        "runtime_sovereignty_change",
        "authority_topology_change",
        "execution_philosophy_change",
        "protocol_governance_change"
      ]
    },
    "deprecation_policy": [
      "active",
      "deprecated",
      "migration_supported",
      "removed"
    ]
  },
  "constitutional_states": {
    "proven": [
      "runtime_external_to_execution_surface",
      "capability_environment_materialization",
      "capability_payload_grounding",
      "readonly_analysis_topology",
      "protocol_oriented_execution"
    ],
    "intended": [
      "bounded_mutation_hardening",
      "capability_coercion",
      "payload_provenance_tracking",
      "schema_strict_mode_validation"
    ],
    "deferred": [
      "advanced_capability_sandboxing",
      "cross_provider_protocol_normalization",
      "distributed_runtime_execution"
    ]
  },
  "architectural_direction": {
    "moving_away_from": [
      "assistant_repository_inheritance",
      "prompt_oriented_execution",
      "implicit_context_topology",
      "hidden_continuity",
      "active_task_as_cognitive_memory"
